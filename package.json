{
  "name": "indab-web-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "emulators": "firebase emulators:start --project demo-indab --only auth,firestore",
    "test:rules": "firebase emulators:exec --project demo-indab --only firestore \"vitest run --config tests/vitest.config.mts\"",
    "test:e2e": "firebase emulators:exec --project demo-indab --only auth,firestore \"playwright test\"",
    "test:all": "npm run test:ci && npm run test:rules && npm run test:e2e",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy": "ng build && firebase deploy --only hosting"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "firebase": "^13.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "firebase-tools": "^15.34.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
