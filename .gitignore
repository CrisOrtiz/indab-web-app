# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# Angular
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# Firebase
.firebase/
*-debug.log
.runtimeconfig.json
# Emulator data exported with --export-on-exit / emulators:export
.emulator-data/
emulator-data/
firebase-export-*/

# Secrets: service account keys and local environment files
*-firebase-adminsdk-*.json
service-account*.json
serviceAccount*.json
credentials*.json
*.pem
*.p12
*.key
.env
.env.*
!.env.example

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.swp
*~

# Visual Studio Code: share workspace settings, keep personal ones local
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/

# Claude Code: share project settings and skills, keep personal ones local
.claude/settings.local.json
CLAUDE.local.md

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
