rules_version = '2';

// Data model
//   users/{uid}                          profile; created by the user, who edits displayName,
//                                        photoURL (a small data: URL image), birthDate and whatsapp;
//                                        role and mentorshipIds (the student's mentorships) change
//                                        by admins only
//   users/{uid}/sessions/{id}            browsers the user is signed in on; the owner signs one out
//                                        by setting revoked, and that browser then signs itself out
//   enrollments/{uid}                    { academy: bool, courses: [courseId], updatedAt, updatedBy };
//                                        admin-managed from the /admin area
//   courses/{courseId}                   course catalog; published courses are public
//   courses/{courseId}/lessons/{id}      lesson content; enrolled users only
//   materials/{materialId}               learning-material repository; enrolled users only
//   investors/{uid}                      Eleva Inversiones investor account; owner reads, admins write
//   mentorships/{id}                     a group of students with its mentors (trainers or admins),
//                                        dates and active flag; admins manage them, staff read them
//                                        and members read their own. Membership lives in the
//                                        student's users/{uid}.mentorshipIds
//   evaluations/{id}                     timed practice evaluation set up by trainers or admins:
//                                        market, replay start, time limit, window, assigned students
//                                        and mentorships
//   examForms/{id}                       evaluation form (questions, points, window, attempts,
//                                        audience: everyone, or chosen students and mentorships)
//                                        built by trainers or admins; no right answers
//   examKeys/{examId}                    right answers of a form; staff only, and assigned students
//                                        once results are published with answers
//   examSubmissions/{examId}_{uid}_{n}   a student's attempt n, saved as they answer until handed in
//   examGrades/{submissionId}            points per question set by staff; the student reads it once
//                                        the form's results are published
//   practiceSessions/{id}                chart-replay practice by a student with academy access;
//                                        owner writes while active, trainers and admins read all.
//                                        Free sessions have evaluationId null; an evaluation attempt
//                                        has the id {evaluationId}_{uid} (one per student) and is
//                                        shown to academy members, for the ranking, once its
//                                        evaluation's results are published
//   practiceSessions/{id}/trades/{id}    simulated orders of that session: market orders open at
//                                        once, limit/stop orders fill or are cancelled once; open
//                                        trades close once; only SL/TP (and a pending price) move;
//                                        staff also read them all as a collection group
//   mentorNotes/{id}                     a mentor's note on a student's practice session, evaluation
//                                        attempt or form attempt; written by admins or by a mentor of
//                                        one of the student's mentorships; staff and the student read
//   users/{uid}/notifications/{id}       the bell in the header: notes, assignments and results for
//                                        students; activity of the students a trainer or admin follows.
//                                        Senders write them (no server); each id names its event, so
//                                        an event notifies each person once
//   users/{uid}/settings/notifications   what a trainer or admin follows and which activity they hear of
//   users/{uid}/settings/chart           the indicators the user keeps on the practice chart
//   follows/{kind}/subjects/{id}/followers/{uid}
//                                        a trainer or admin following a student, a mentorship, an
//                                        evaluation, a form or everyone ('all'); students read the
//                                        followers of what concerns them to notify them
//
// Admins are users whose profile has role == 'admin'. Promote the first admin by editing
// their users/{uid} document in the Firebase console; after that, admins manage roles and
// academy access from the /admin area. Admins cannot remove their own admin role, so the
// last admin can never lock everyone out. Trainers (role == 'trainer') run evaluations and
// review practice, but cannot change roles, academy access or mentorships, or delete anything
// but evaluations and evaluation forms.
// Academy content also needs a verified email (emailVerified()), so an account registered with
// someone else's address never opens it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function role() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    // Trainers and admins.
    function isStaff() {
      return role() in ['trainer', 'admin'];
    }

    function enrollment() {
      return get(/databases/$(database)/documents/enrollments/$(request.auth.uid)).data;
    }

    function hasEnrollment() {
      return signedIn() && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid));
    }

    // Google accounts are verified; email sign-ups confirm the link we email them.
    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function hasAcademyAccess() {
      return emailVerified() && (isStaff() || (hasEnrollment() && enrollment().academy == true));
    }

    // The mentorships the signed-in user belongs to.
    function myMentorships() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('mentorshipIds', [])
        : [];
    }

    // An evaluation or form given to the signed-in student by name or through a mentorship.
    function assignedTo(data) {
      return signedIn()
        && (request.auth.uid in data.studentIds
          || data.get('mentorshipIds', []).hasAny(myMentorships()));
    }

    // Optional list of mentorship ids on an evaluation or form.
    function validMentorshipIds(data) {
      return !('mentorshipIds' in data)
        || (data.mentorshipIds is list && data.mentorshipIds.size() <= 50);
    }

    function isEnrolledIn(courseId) {
      return hasAcademyAccess()
        || (emailVerified() && hasEnrollment()
          && enrollment().courses is list && courseId in enrollment().courses);
    }

    match /users/{uid} {
      // Trainers read profiles to assign students to evaluations.
      allow read: if isOwner(uid) || isStaff();

      // Birth date as YYYY-MM-DD and an optional WhatsApp number with country code (+ and digits).
      function validDetails(data) {
        return (!('birthDate' in data)
            || (data.birthDate is string && data.birthDate.matches('(19|20)[0-9]{2}-[01][0-9]-[0-3][0-9]')))
          && (!('whatsapp' in data)
            || (data.whatsapp is string && data.whatsapp.matches('[+][0-9]{8,15}')));
      }

      // A new profile must belong to the caller and always starts as a student.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt',
          'birthDate', 'whatsapp'])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && validDetails(request.resource.data);

      // The profile photo is a small image stored inline (no Cloud Storage bucket needed).
      function validPhoto(data) {
        return !('photoURL' in data)
          || (data.photoURL is string
            && data.photoURL.size() <= 100000
            && data.photoURL.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'));
      }

      // Admins change a user's role and mentorships (never their own). Users can edit their own
      // name, photo and details but never their role, mentorships or identity fields.
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'mentorshipIds'])
          && request.resource.data.role in ['student', 'trainer', 'admin']
          && (!('mentorshipIds' in request.resource.data)
            || (request.resource.data.mentorshipIds is list
              && request.resource.data.mentorshipIds.size() <= 20))
          && !isOwner(uid))
        || (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'birthDate', 'whatsapp'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80
          && validPhoto(request.resource.data)
          && validDetails(request.resource.data));

      allow delete: if isAdmin();

      // Each browser records itself; the owner sees them all and signs any of them out. This
      // asks the other browser to sign out, it does not revoke its token (that needs the Admin
      // SDK): changing the password does, as Firebase then ends every other session.
      match /sessions/{sessionId} {
        function validName(value) {
          return value is string && value.size() <= 40;
        }

        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['browser', 'os', 'mobile', 'createdAt',
            'lastSeen', 'revoked'])
          && validName(request.resource.data.browser)
          && validName(request.resource.data.os)
          && request.resource.data.mobile is bool
          && request.resource.data.createdAt == request.time
          && request.resource.data.lastSeen == request.time
          && request.resource.data.revoked == false;

        // The browser refreshes lastSeen; any of the owner's browsers can sign it out, once.
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'revoked'])
          && (request.resource.data.lastSeen == resource.data.lastSeen
            || request.resource.data.lastSeen == request.time)
          && request.resource.data.revoked is bool
          && (resource.data.revoked == false || request.resource.data.revoked == true);

        allow delete: if isOwner(uid) || isAdmin();
      }

      // What a trainer or admin follows (the follower documents below mirror it, so students can
      // find whom to notify) and which activity they want to hear of; everyone's chart settings.
      match /settings/{setting} {
        function validIds(value) {
          return value is list && value.size() <= 100;
        }

        function notificationSettings() {
          return isStaff()
            && request.resource.data.keys().hasOnly(['types', 'all', 'studentIds',
              'mentorshipIds', 'evaluationIds', 'examIds', 'updatedAt'])
            && request.resource.data.types is list
            && request.resource.data.types.hasOnly(activityTypes())
            && request.resource.data.all is bool
            && validIds(request.resource.data.studentIds)
            && validIds(request.resource.data.mentorshipIds)
            && validIds(request.resource.data.evaluationIds)
            && validIds(request.resource.data.examIds)
            && request.resource.data.updatedAt == request.time;
        }

        // The practice chart's indicators (ids of INDICATORS in indicators.ts), for anyone.
        function chartSettings() {
          return request.resource.data.keys().hasOnly(['indicators', 'updatedAt'])
            && request.resource.data.indicators is list
            && request.resource.data.indicators.hasOnly(['ema100', 'ema200', 'rsi14', 'volume'])
            && request.resource.data.updatedAt == request.time;
        }

        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && ((setting == 'notifications' && notificationSettings())
            || (setting == 'chart' && chartSettings()));
      }

      // The bell. Nobody but the owner reads, marks as read or deletes them. Each kind of event
      // checks that it happened and that the sender may tell the owner about it; the id names
      // the event, so it is sent once.
      match /notifications/{notificationId} {
        function data() {
          return request.resource.data;
        }

        // A mentor's new note on the owner's work, written in the same batch as the note.
        function noteNotice() {
          return data().type == 'note'
            && data().noteId is string
            && notificationId == 'note_' + data().noteId
            && data().studentId == uid
            && getAfter(/databases/$(database)/documents/mentorNotes/$(data().noteId)).data.authorId == request.auth.uid
            && getAfter(/databases/$(database)/documents/mentorNotes/$(data().noteId)).data.studentId == uid
            && getAfter(/databases/$(database)/documents/mentorNotes/$(data().noteId)).data.targetId == data().refId
            && getAfter(/databases/$(database)/documents/mentorNotes/$(data().noteId)).data.kind == data().kind;
        }

        // The owner, a student, among those an evaluation or form is given to.
        function inAudience(item) {
          return uid in item.studentIds
            || item.get('mentorshipIds', []).hasAny(
              get(/databases/$(database)/documents/users/$(uid)).data.get('mentorshipIds', []));
        }

        function evaluationDoc() {
          return get(/databases/$(database)/documents/evaluations/$(data().refId)).data;
        }

        function examDoc() {
          return get(/databases/$(database)/documents/examForms/$(data().refId)).data;
        }

        // Staff tell students of an evaluation or form given to them, and of published results
        // (only to those who took it).
        function staffNotice() {
          return isStaff()
            && data().type in ['assigned', 'results']
            && notificationId == data().type + '_' + data().refId
            && data().studentId == uid
            && data().contextId == data().refId
            && ((data().kind == 'evaluation'
                && exists(/databases/$(database)/documents/evaluations/$(data().refId))
                && ((data().type == 'assigned' && inAudience(evaluationDoc()))
                  || (data().type == 'results' && evaluationDoc().resultsPublished == true
                    && exists(/databases/$(database)/documents/practiceSessions/$(data().refId + '_' + uid)))))
              || (data().kind == 'exam'
                && exists(/databases/$(database)/documents/examForms/$(data().refId))
                && ((data().type == 'assigned' && examDoc().published == true
                    && (examDoc().audience == 'all' || inAudience(examDoc())))
                  || (data().type == 'results' && examDoc().resultsPublished == true
                    && exists(/databases/$(database)/documents/examSubmissions/$(data().refId + '_' + uid + '_1'))))));
        }

        function followerPath() {
          return /databases/$(database)/documents/follows/$(data().followKind)/subjects/$(data().followId)/followers/$(uid);
        }

        // The owner follows the sender (by name, mentorship, the evaluation or form, or everyone)
        // for this kind of activity.
        function follows() {
          return data().followKind is string && data().followId is string
            && exists(followerPath())
            && data().type in get(followerPath()).data.types
            && ((data().followKind == 'student' && data().followId == request.auth.uid)
              || (data().followKind == 'all' && data().followId == 'all')
              || (data().followKind == 'mentorship' && data().followId in myMentorships())
              || (data().followKind == 'evaluation' && data().type == 'evaluationFinished'
                && data().followId == data().contextId)
              || (data().followKind == 'exam' && data().type == 'examSubmitted'
                && data().followId == data().contextId));
        }

        function sessionDoc() {
          return get(/databases/$(database)/documents/practiceSessions/$(data().refId)).data;
        }

        function submissionDoc() {
          return get(/databases/$(database)/documents/examSubmissions/$(data().refId)).data;
        }

        // A student tells the staff who follow them that they finished something.
        function activityNotice() {
          return data().studentId == request.auth.uid
            && notificationId == data().type + '_' + data().refId
            && follows()
            && ((data().type == 'practiceFinished' && data().kind == 'practice'
                && data().contextId == null
                && sessionDoc().uid == request.auth.uid && sessionDoc().status == 'finished'
                && sessionDoc().get('evaluationId', null) == null)
              || (data().type == 'evaluationFinished' && data().kind == 'evaluation'
                && data().contextId is string
                && sessionDoc().uid == request.auth.uid && sessionDoc().status == 'finished'
                && sessionDoc().get('evaluationId', null) == data().contextId)
              || (data().type == 'examSubmitted' && data().kind == 'exam'
                && submissionDoc().uid == request.auth.uid
                && submissionDoc().status == 'submitted'
                && submissionDoc().examId == data().contextId));
        }

        allow read: if isOwner(uid);

        allow create: if signedIn() && !isOwner(uid)
          && data().keys().hasOnly(['type', 'kind', 'refId', 'contextId', 'noteId', 'title',
            'actorId', 'actorName', 'studentId', 'followKind', 'followId', 'read', 'createdAt'])
          && data().kind in ['practice', 'evaluation', 'exam']
          && data().refId is string
          && (data().contextId == null || data().contextId is string)
          && data().title is string && data().title.size() <= 120
          && data().actorId == request.auth.uid
          && data().actorName is string && data().actorName.size() <= 120
          && data().read == false
          && data().createdAt == request.time
          && (noteNotice() || staffNotice() || activityNotice());

        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;

        allow delete: if isOwner(uid);
      }
    }

    // Student activity a trainer or admin can be told of.
    function activityTypes() {
      return ['practiceFinished', 'evaluationFinished', 'examSubmitted'];
    }

    // Followers of a subject: a student (by uid), a mentorship, an evaluation, a form, or 'all'.
    // A student lists the followers of what concerns them, to notify them when they finish
    // something; nobody else learns who follows whom.
    match /follows/{kind}/subjects/{subjectId}/followers/{staffUid} {
      allow read: if isOwner(staffUid)
        || (kind == 'student' && isOwner(subjectId))
        || (kind == 'all' && subjectId == 'all' && signedIn())
        || (kind == 'mentorship' && subjectId in myMentorships())
        || (kind == 'evaluation' && signedIn()
          && exists(/databases/$(database)/documents/evaluations/$(subjectId))
          && assignedTo(get(/databases/$(database)/documents/evaluations/$(subjectId)).data))
        || (kind == 'exam' && signedIn()
          && exists(/databases/$(database)/documents/examForms/$(subjectId))
          && assignedExam(examForm(subjectId)));

      allow create, update: if isOwner(staffUid) && isStaff()
        && kind in ['student', 'mentorship', 'evaluation', 'exam', 'all']
        && (kind != 'all' || subjectId == 'all')
        && request.resource.data.keys().hasOnly(['types', 'updatedAt'])
        && request.resource.data.types is list
        && request.resource.data.types.size() > 0
        && request.resource.data.types.hasOnly(activityTypes())
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(staffUid) || isAdmin();
    }

    // A mentor's note on a student's practice session, evaluation attempt or form attempt.
    // Admins write on anyone's; trainers (and admins) who mentor one of the student's
    // mentorships write on its students', naming that mentorship. The student reads them.
    match /mentorNotes/{noteId} {
      function practiceSession(id) {
        return get(/databases/$(database)/documents/practiceSessions/$(id)).data;
      }

      function submission(id) {
        return get(/databases/$(database)/documents/examSubmissions/$(id)).data;
      }

      // The note is on the student's own work, and says what it belongs to.
      function validTarget(data) {
        return (data.kind == 'practice'
            && exists(/databases/$(database)/documents/practiceSessions/$(data.targetId))
            && practiceSession(data.targetId).uid == data.studentId
            && practiceSession(data.targetId).get('evaluationId', null) == null
            && data.contextId == null)
          || (data.kind == 'evaluation'
            && exists(/databases/$(database)/documents/practiceSessions/$(data.targetId))
            && practiceSession(data.targetId).uid == data.studentId
            && data.contextId is string
            && practiceSession(data.targetId).get('evaluationId', null) == data.contextId)
          || (data.kind == 'exam'
            && exists(/databases/$(database)/documents/examSubmissions/$(data.targetId))
            && submission(data.targetId).uid == data.studentId
            && submission(data.targetId).examId == data.contextId);
      }

      // Admins, or a mentor of a mentorship the student belongs to.
      function mentorOf(data) {
        return isAdmin()
          || (isStaff() && data.mentorshipId is string
            && data.mentorshipId in get(/databases/$(database)/documents/users/$(data.studentId)).data.get('mentorshipIds', [])
            && request.auth.uid in get(/databases/$(database)/documents/mentorships/$(data.mentorshipId)).data.mentorIds);
      }

      function validText(data) {
        return data.text is string && data.text.trim().size() > 0 && data.text.size() <= 2000;
      }

      allow read: if isStaff() || (signedIn() && resource.data.studentId == request.auth.uid);

      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['studentId', 'kind', 'targetId', 'contextId',
          'mentorshipId', 'text', 'authorId', 'authorName', 'createdAt', 'updatedAt'])
        && request.resource.data.studentId is string
        && request.resource.data.studentId != request.auth.uid
        && request.resource.data.targetId is string
        && (request.resource.data.mentorshipId == null || request.resource.data.mentorshipId is string)
        && validText(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validTarget(request.resource.data)
        && mentorOf(request.resource.data);

      // The author edits the text while they still mentor the student.
      allow update: if resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])
        && validText(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && mentorOf(request.resource.data);

      allow delete: if (signedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    match /enrollments/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['academy', 'courses', 'updatedAt', 'updatedBy'])
        && request.resource.data.academy is bool
        && request.resource.data.courses is list
        && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if isEnrolledIn(courseId);
        allow write: if isAdmin();
      }
    }

    match /materials/{materialId} {
      allow read: if hasAcademyAccess();
      allow write: if isAdmin();
    }

    match /investors/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Mentorships group students under one or more mentors. Admins manage them and assign
    // students (users/{uid}.mentorshipIds); trainers read them to assign forms and evaluations
    // to a whole group; students read the ones they belong to.
    match /mentorships/{mentorshipId} {
      function validDate(value) {
        return value is string && value.matches('(19|20)[0-9]{2}-[01][0-9]-[0-3][0-9]');
      }

      function validMentorship(data) {
        return data.keys().hasOnly(['name', 'description', 'mentorIds', 'startDate', 'endDate',
            'active', 'createdBy', 'createdAt', 'updatedAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 80
          && data.description is string && data.description.size() <= 1000
          && data.mentorIds is list && data.mentorIds.size() <= 10
          && validDate(data.startDate)
          && (data.endDate == null || (validDate(data.endDate) && data.endDate >= data.startDate))
          && data.active is bool
          && data.updatedAt == request.time;
      }

      allow read: if isStaff() || (signedIn() && mentorshipId in myMentorships());

      allow create: if isAdmin()
        && validMentorship(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        && validMentorship(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAdmin();
    }

    // Practice evaluations: trainers and admins set them up; assigned students (by name or
    // through a mentorship) read them.
    match /evaluations/{evaluationId} {
      function validEvaluation(data) {
        return data.keys().hasOnly(['title', 'description', 'symbol', 'replayStart', 'hideDates',
            'startingBalance', 'durationMinutes', 'opensAt', 'closesAt', 'studentIds',
            'mentorshipIds', 'resultsPublished', 'createdBy', 'createdAt', 'updatedAt'])
          && data.title is string && data.title.size() > 0 && data.title.size() <= 120
          && data.description is string && data.description.size() <= 2000
          && data.symbol is string && data.symbol.size() <= 20
          && data.replayStart is int
          && data.hideDates is bool
          && data.startingBalance is number && data.startingBalance > 0
          && data.durationMinutes is int && data.durationMinutes >= 5 && data.durationMinutes <= 600
          && data.opensAt is timestamp && data.closesAt is timestamp
          && data.closesAt > data.opensAt
          && data.studentIds is list && data.studentIds.size() <= 500
          && validMentorshipIds(data)
          && data.resultsPublished is bool
          && data.updatedAt == request.time;
      }

      allow read: if isStaff() || assignedTo(resource.data);

      allow create: if isStaff()
        && validEvaluation(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isStaff()
        && validEvaluation(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isStaff();
    }

    // Evaluation forms. Staff build them; students with academy access see the published ones
    // assigned to them. Right answers and grades live in their own documents so students never
    // read them before staff publish the results.
    function examForm(id) {
      return get(/databases/$(database)/documents/examForms/$(id)).data;
    }

    function assignedExam(exam) {
      return hasAcademyAccess() && exam.published == true
        && (exam.audience == 'all' || assignedTo(exam));
    }

    match /examForms/{examId} {
      function validExam(data) {
        return data.keys().hasOnly(['title', 'description', 'totalPoints', 'passingPoints',
            'durationMinutes', 'maxAttempts', 'audience', 'studentIds', 'mentorshipIds', 'opensAt',
            'closesAt',
            'questions', 'published', 'resultsPublished', 'showAnswers', 'createdBy', 'createdAt',
            'updatedAt'])
          && data.title is string && data.title.size() > 0 && data.title.size() <= 120
          && data.description is string && data.description.size() <= 2000
          && data.totalPoints is number && data.totalPoints > 0 && data.totalPoints <= 1000
          && data.passingPoints is number && data.passingPoints >= 0
          && data.passingPoints <= data.totalPoints
          && data.durationMinutes is int && data.durationMinutes >= 0 && data.durationMinutes <= 600
          && data.maxAttempts is int && data.maxAttempts >= 1 && data.maxAttempts <= 3
          && data.audience in ['all', 'selected']
          && data.studentIds is list && data.studentIds.size() <= 500
          && validMentorshipIds(data)
          && data.opensAt is timestamp && data.closesAt is timestamp
          && data.closesAt > data.opensAt
          && data.questions is list && data.questions.size() <= 100
          && data.published is bool && data.resultsPublished is bool && data.showAnswers is bool
          && data.updatedAt == request.time;
      }

      allow read: if isStaff() || assignedExam(resource.data);

      allow create: if isStaff()
        && validExam(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isStaff()
        && validExam(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isStaff();
    }

    match /examKeys/{examId} {
      allow read: if isStaff()
        || (signedIn() && exists(/databases/$(database)/documents/examForms/$(examId))
          && assignedExam(examForm(examId))
          && examForm(examId).resultsPublished == true
          && examForm(examId).showAnswers == true);

      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['answers', 'updatedAt'])
        && request.resource.data.answers is map
        && request.resource.data.updatedAt == request.time;

      allow delete: if isStaff();
    }

    match /examSubmissions/{submissionId} {
      // Answers are taken until the time limit (and the window's close) plus two minutes.
      function inTime(exam, startedAt) {
        return request.time < exam.closesAt + duration.value(2, 'm')
          && (exam.durationMinutes == 0
            || request.time < startedAt + duration.value(exam.durationMinutes + 2, 'm'));
      }

      // A later attempt waits until the previous one is handed in or its time ran out.
      function previousDone(data) {
        let prevPath = /databases/$(database)/documents/examSubmissions/$(data.examId + '_' + request.auth.uid + '_' + string(data.attempt - 1));
        let exam = examForm(data.examId);
        return data.attempt == 1
          || (exists(prevPath)
            && (get(prevPath).data.status == 'submitted'
              || (exam.durationMinutes > 0
                && request.time >= get(prevPath).data.startedAt
                  + duration.value(exam.durationMinutes + 2, 'm'))));
      }

      function validAnswers(data) {
        return data.answers is map && data.answers.size() <= 100;
      }

      allow read: if isStaff() || isOwner(resource.data.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['examId', 'uid', 'userName', 'attempt',
          'status', 'answers', 'startedAt', 'submittedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.examId is string
        && request.resource.data.attempt is int
        && submissionId == request.resource.data.examId + '_' + request.auth.uid + '_'
          + string(request.resource.data.attempt)
        && exists(/databases/$(database)/documents/examForms/$(request.resource.data.examId))
        && assignedExam(examForm(request.resource.data.examId))
        && request.resource.data.attempt >= 1
        && request.resource.data.attempt <= examForm(request.resource.data.examId).maxAttempts
        && request.time >= examForm(request.resource.data.examId).opensAt
        && request.time < examForm(request.resource.data.examId).closesAt
        && previousDone(request.resource.data)
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 120
        && request.resource.data.status == 'inProgress'
        && validAnswers(request.resource.data)
        && request.resource.data.startedAt == request.time
        && request.resource.data.submittedAt == null;

      // The owner saves answers while the attempt is open and finally hands it in.
      allow update: if isOwner(resource.data.uid)
        && resource.data.status == 'inProgress'
        && inTime(examForm(resource.data.examId), resource.data.startedAt)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['answers', 'status', 'submittedAt'])
        && validAnswers(request.resource.data)
        && ((request.resource.data.status == 'inProgress'
            && request.resource.data.submittedAt == null)
          || (request.resource.data.status == 'submitted'
            && request.resource.data.submittedAt == request.time));
    }

    match /examGrades/{gradeId} {
      allow read: if isStaff()
        || (isOwner(resource.data.uid)
          && examForm(resource.data.examId).resultsPublished == true);

      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['examId', 'uid', 'attempt', 'scores', 'comments',
          'feedback', 'total', 'passed', 'gradedBy', 'gradedAt'])
        && request.resource.data.examId is string
        && request.resource.data.uid is string
        && request.resource.data.attempt is int
        && gradeId == request.resource.data.examId + '_' + request.resource.data.uid + '_'
          + string(request.resource.data.attempt)
        && exists(/databases/$(database)/documents/examSubmissions/$(gradeId))
        && request.resource.data.scores is map
        && request.resource.data.comments is map
        && request.resource.data.feedback is string
        && request.resource.data.feedback.size() <= 2000
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.passed is bool
        && request.resource.data.gradedBy == request.auth.uid
        && request.resource.data.gradedAt == request.time;

      allow delete: if isStaff();
    }

    // Chart-replay practice. Students log their own sessions and trades; nothing can be
    // deleted or rewritten afterwards, so instructors see every trade as it happened.
    match /practiceSessions/{sessionId} {
      function validSummary(data) {
        return data.balance is number && data.pnl is number
          && data.tradeCount is int && data.tradeCount >= 0;
      }

      function evaluation(id) {
        return get(/databases/$(database)/documents/evaluations/$(id)).data;
      }

      // A new evaluation attempt: one per assigned student, started inside the window, on the
      // evaluation's market, replay start, balance and time limit.
      function validAttempt(data) {
        return sessionId == data.evaluationId + '_' + request.auth.uid
          && exists(/databases/$(database)/documents/evaluations/$(data.evaluationId))
          && assignedTo(evaluation(data.evaluationId))
          && request.time >= evaluation(data.evaluationId).opensAt
          && request.time < evaluation(data.evaluationId).closesAt
          && data.symbol == evaluation(data.evaluationId).symbol
          && data.replayStart == evaluation(data.evaluationId).replayStart
          && data.startingBalance == evaluation(data.evaluationId).startingBalance
          && data.durationMinutes == evaluation(data.evaluationId).durationMinutes;
      }

      // Results of a published evaluation are open to everyone with academy access.
      function publishedAttempt(data) {
        return data.evaluationId != null
          && exists(/databases/$(database)/documents/evaluations/$(data.evaluationId))
          && evaluation(data.evaluationId).resultsPublished == true;
      }

      allow read: if isOwner(resource.data.uid) || isStaff()
        || (hasAcademyAccess() && publishedAttempt(resource.data));

      allow create: if hasAcademyAccess()
        && request.resource.data.keys().hasOnly(['uid', 'userName', 'symbol', 'interval',
          'replayStart', 'startingBalance', 'balance', 'pnl', 'tradeCount', 'status', 'startedAt',
          'evaluationId', 'durationMinutes'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 120
        && request.resource.data.symbol is string
        && request.resource.data.symbol.size() <= 20
        && request.resource.data.interval in ['1m', '3m', '5m', '15m', '1h', '4h', '1d']
        && request.resource.data.replayStart is int
        && request.resource.data.startingBalance is number
        && request.resource.data.balance == request.resource.data.startingBalance
        && request.resource.data.pnl == 0
        && request.resource.data.tradeCount == 0
        && request.resource.data.status == 'active'
        && request.resource.data.startedAt == request.time
        && ((request.resource.data.evaluationId == null
            && !('durationMinutes' in request.resource.data))
          || (request.resource.data.evaluationId is string
            && validAttempt(request.resource.data)));

      // While active, the owner refreshes the summary and finally marks it finished. An
      // evaluation attempt accepts these until two minutes after its time is up.
      allow update: if isOwner(resource.data.uid)
        && resource.data.status == 'active'
        && (resource.data.get('durationMinutes', null) == null
          || request.time < resource.data.startedAt
            + duration.value(resource.data.durationMinutes + 2, 'm'))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['balance', 'pnl', 'tradeCount', 'status', 'endedAt'])
        && validSummary(request.resource.data)
        && (request.resource.data.status == 'active'
          || (request.resource.data.status == 'finished' && request.resource.data.endedAt == request.time));

      allow delete: if isAdmin();

      match /trades/{tradeId} {
        function session() {
          return get(/databases/$(database)/documents/practiceSessions/$(sessionId)).data;
        }

        // An evaluation attempt takes orders until its time is up, and closes them for two
        // minutes more; free practice has no limit.
        function inTime(extraMinutes) {
          return session().get('durationMinutes', null) == null
            || request.time < session().startedAt
              + duration.value(session().durationMinutes + extraMinutes, 'm');
        }

        function isPrice(value) {
          return value is number && value > 0;
        }

        function optionalPrice(value) {
          return value == null || isPrice(value);
        }

        function changes(keys) {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
        }

        allow read: if isStaff() || (signedIn() && session().uid == request.auth.uid);

        // Placed by the session's owner while the session is active: a market order opens at
        // once, a limit or stop order waits as `pending` at its order price.
        allow create: if signedIn()
          && session().uid == request.auth.uid
          && session().status == 'active'
          && inTime(0)
          && request.resource.data.keys().hasOnly(['uid', 'side', 'orderType', 'orderPrice',
            'placedTime', 'quantity', 'entryPrice', 'entryTime', 'stopLoss', 'takeProfit',
            'status', 'openedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.side in ['long', 'short']
          && isPrice(request.resource.data.quantity)
          && isPrice(request.resource.data.entryPrice)
          && request.resource.data.placedTime is int
          && request.resource.data.entryTime == request.resource.data.placedTime
          && optionalPrice(request.resource.data.stopLoss)
          && optionalPrice(request.resource.data.takeProfit)
          && ((request.resource.data.orderType == 'market'
              && request.resource.data.orderPrice == null
              && request.resource.data.status == 'open')
            || (request.resource.data.orderType in ['limit', 'stop']
              && request.resource.data.orderPrice == request.resource.data.entryPrice
              && request.resource.data.status == 'pending'))
          && request.resource.data.openedAt == request.time;

        allow update: if isOwner(resource.data.uid) && inTime(2) && (
          // A pending order moves its price, stop loss or take profit...
          (resource.data.status == 'pending'
            && changes(['orderPrice', 'entryPrice', 'stopLoss', 'takeProfit'])
            && isPrice(request.resource.data.orderPrice)
            && request.resource.data.entryPrice == request.resource.data.orderPrice
            && optionalPrice(request.resource.data.stopLoss)
            && optionalPrice(request.resource.data.takeProfit))
          // ...fills once...
          || (resource.data.status == 'pending'
            && changes(['status', 'entryPrice', 'entryTime', 'filledAt'])
            && request.resource.data.status == 'open'
            && isPrice(request.resource.data.entryPrice)
            && request.resource.data.entryTime is int
            && request.resource.data.entryTime > resource.data.placedTime
            && request.resource.data.filledAt == request.time)
          // ...or is cancelled.
          || (resource.data.status == 'pending'
            && changes(['status', 'closedAt'])
            && request.resource.data.status == 'cancelled'
            && request.resource.data.closedAt == request.time)
          // An open trade moves its stop loss or take profit; its entry never changes...
          || (resource.data.status == 'open'
            && changes(['stopLoss', 'takeProfit'])
            && optionalPrice(request.resource.data.stopLoss)
            && optionalPrice(request.resource.data.takeProfit))
          // ...and is closed exactly once.
          || (resource.data.status == 'open'
            && changes(['status', 'exitPrice', 'exitTime', 'exitReason', 'pnl', 'closedAt'])
            && request.resource.data.status == 'closed'
            && isPrice(request.resource.data.exitPrice)
            && request.resource.data.exitTime is int
            && request.resource.data.exitTime >= resource.data.entryTime
            && request.resource.data.exitReason in ['manual', 'stopLoss', 'takeProfit', 'stopOut', 'sessionEnd']
            && request.resource.data.pnl is number
            && request.resource.data.closedAt == request.time));

        allow delete: if isAdmin();
      }
    }

    // Trades of every session at once (a collection group query), for the mentor dashboard's
    // win rates. Staff only: students read their own through their session.
    match /{path=**}/trades/{tradeId} {
      allow read: if isStaff();
    }

    // Everything else is closed by default.
  }
}
