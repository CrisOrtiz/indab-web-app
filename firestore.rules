rules_version = '2';

// Data model
//   users/{uid}                          profile; created by the user, role changes by admins only
//   enrollments/{uid}                    { academy: bool, courses: [courseId], updatedAt, updatedBy };
//                                        admin-managed from the /admin area
//   courses/{courseId}                   course catalog; published courses are public
//   courses/{courseId}/lessons/{id}      lesson content; enrolled users only
//   materials/{materialId}               learning-material repository; enrolled users only
//   investors/{uid}                      Eleva Inversiones investor account; owner reads, admins write
//   evaluations/{id}                     timed practice evaluation set up by trainers or admins:
//                                        market, replay start, time limit, window, assigned students
//   practiceSessions/{id}                chart-replay practice by a student with academy access;
//                                        owner writes while active, trainers and admins read all.
//                                        Free sessions (evaluationId null) are listed in the ranking
//                                        for everyone with academy access; an evaluation attempt has
//                                        the id {evaluationId}_{uid} (one per student) and is shown
//                                        to others once its results are published
//   practiceSessions/{id}/trades/{id}    simulated orders of that session: market orders open at
//                                        once, limit/stop orders fill or are cancelled once; open
//                                        trades close once; only SL/TP (and a pending price) move
//
// Admins are users whose profile has role == 'admin'. Promote the first admin by editing
// their users/{uid} document in the Firebase console; after that, admins manage roles and
// academy access from the /admin area. Admins cannot remove their own admin role, so the
// last admin can never lock everyone out. Trainers (role == 'trainer') run evaluations and
// review practice, but cannot change roles, academy access or delete anything but evaluations.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function role() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    // Trainers and admins.
    function isStaff() {
      return role() in ['trainer', 'admin'];
    }

    function enrollment() {
      return get(/databases/$(database)/documents/enrollments/$(request.auth.uid)).data;
    }

    function hasEnrollment() {
      return signedIn() && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid));
    }

    function hasAcademyAccess() {
      return isStaff() || (hasEnrollment() && enrollment().academy == true);
    }

    function isEnrolledIn(courseId) {
      return hasAcademyAccess()
        || (hasEnrollment() && enrollment().courses is list && courseId in enrollment().courses);
    }

    match /users/{uid} {
      // Trainers read profiles to assign students to evaluations.
      allow read: if isOwner(uid) || isStaff();

      // A new profile must belong to the caller and always starts as a student.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80;

      // Admins can change a user's role (never their own). Users can edit their own profile
      // but never their role or identity fields.
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['student', 'trainer', 'admin']
          && !isOwner(uid))
        || (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80);

      allow delete: if isAdmin();
    }

    match /enrollments/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['academy', 'courses', 'updatedAt', 'updatedBy'])
        && request.resource.data.academy is bool
        && request.resource.data.courses is list
        && (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();

      match /lessons/{lessonId} {
        allow read: if isEnrolledIn(courseId);
        allow write: if isAdmin();
      }
    }

    match /materials/{materialId} {
      allow read: if hasAcademyAccess();
      allow write: if isAdmin();
    }

    match /investors/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Practice evaluations: trainers and admins set them up; assigned students read them.
    match /evaluations/{evaluationId} {
      function validEvaluation(data) {
        return data.keys().hasOnly(['title', 'description', 'symbol', 'replayStart', 'hideDates',
            'startingBalance', 'durationMinutes', 'opensAt', 'closesAt', 'studentIds',
            'resultsPublished', 'createdBy', 'createdAt', 'updatedAt'])
          && data.title is string && data.title.size() > 0 && data.title.size() <= 120
          && data.description is string && data.description.size() <= 2000
          && data.symbol is string && data.symbol.size() <= 20
          && data.replayStart is int
          && data.hideDates is bool
          && data.startingBalance is number && data.startingBalance > 0
          && data.durationMinutes is int && data.durationMinutes >= 5 && data.durationMinutes <= 600
          && data.opensAt is timestamp && data.closesAt is timestamp
          && data.closesAt > data.opensAt
          && data.studentIds is list && data.studentIds.size() <= 500
          && data.resultsPublished is bool
          && data.updatedAt == request.time;
      }

      allow read: if isStaff() || (signedIn() && request.auth.uid in resource.data.studentIds);

      allow create: if isStaff()
        && validEvaluation(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isStaff()
        && validEvaluation(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isStaff();
    }

    // Chart-replay practice. Students log their own sessions and trades; nothing can be
    // deleted or rewritten afterwards, so instructors see every trade as it happened.
    match /practiceSessions/{sessionId} {
      function validSummary(data) {
        return data.balance is number && data.pnl is number
          && data.tradeCount is int && data.tradeCount >= 0;
      }

      function evaluation(id) {
        return get(/databases/$(database)/documents/evaluations/$(id)).data;
      }

      // A new evaluation attempt: one per assigned student, started inside the window, on the
      // evaluation's market, replay start, balance and time limit.
      function validAttempt(data) {
        return sessionId == data.evaluationId + '_' + request.auth.uid
          && exists(/databases/$(database)/documents/evaluations/$(data.evaluationId))
          && request.auth.uid in evaluation(data.evaluationId).studentIds
          && request.time >= evaluation(data.evaluationId).opensAt
          && request.time < evaluation(data.evaluationId).closesAt
          && data.symbol == evaluation(data.evaluationId).symbol
          && data.replayStart == evaluation(data.evaluationId).replayStart
          && data.startingBalance == evaluation(data.evaluationId).startingBalance
          && data.durationMinutes == evaluation(data.evaluationId).durationMinutes;
      }

      // Results of a published evaluation are open to everyone with academy access.
      function publishedAttempt(data) {
        return data.evaluationId != null
          && exists(/databases/$(database)/documents/evaluations/$(data.evaluationId))
          && evaluation(data.evaluationId).resultsPublished == true;
      }

      allow read: if isOwner(resource.data.uid) || isStaff()
        || (hasAcademyAccess()
          && (resource.data.evaluationId == null || publishedAttempt(resource.data)));

      allow create: if hasAcademyAccess()
        && request.resource.data.keys().hasOnly(['uid', 'userName', 'symbol', 'interval',
          'replayStart', 'startingBalance', 'balance', 'pnl', 'tradeCount', 'status', 'startedAt',
          'evaluationId', 'durationMinutes'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 120
        && request.resource.data.symbol is string
        && request.resource.data.symbol.size() <= 20
        && request.resource.data.interval in ['1m', '3m', '5m', '15m', '1h', '4h', '1d']
        && request.resource.data.replayStart is int
        && request.resource.data.startingBalance is number
        && request.resource.data.balance == request.resource.data.startingBalance
        && request.resource.data.pnl == 0
        && request.resource.data.tradeCount == 0
        && request.resource.data.status == 'active'
        && request.resource.data.startedAt == request.time
        && ((request.resource.data.evaluationId == null
            && !('durationMinutes' in request.resource.data))
          || (request.resource.data.evaluationId is string
            && validAttempt(request.resource.data)));

      // While active, the owner refreshes the summary and finally marks it finished. An
      // evaluation attempt accepts these until two minutes after its time is up.
      allow update: if isOwner(resource.data.uid)
        && resource.data.status == 'active'
        && (resource.data.get('durationMinutes', null) == null
          || request.time < resource.data.startedAt
            + duration.value(resource.data.durationMinutes + 2, 'm'))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['balance', 'pnl', 'tradeCount', 'status', 'endedAt'])
        && validSummary(request.resource.data)
        && (request.resource.data.status == 'active'
          || (request.resource.data.status == 'finished' && request.resource.data.endedAt == request.time));

      allow delete: if isAdmin();

      match /trades/{tradeId} {
        function session() {
          return get(/databases/$(database)/documents/practiceSessions/$(sessionId)).data;
        }

        // An evaluation attempt takes orders until its time is up, and closes them for two
        // minutes more; free practice has no limit.
        function inTime(extraMinutes) {
          return session().get('durationMinutes', null) == null
            || request.time < session().startedAt
              + duration.value(session().durationMinutes + extraMinutes, 'm');
        }

        function isPrice(value) {
          return value is number && value > 0;
        }

        function optionalPrice(value) {
          return value == null || isPrice(value);
        }

        function changes(keys) {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
        }

        allow read: if isStaff() || (signedIn() && session().uid == request.auth.uid);

        // Placed by the session's owner while the session is active: a market order opens at
        // once, a limit or stop order waits as `pending` at its order price.
        allow create: if signedIn()
          && session().uid == request.auth.uid
          && session().status == 'active'
          && inTime(0)
          && request.resource.data.keys().hasOnly(['uid', 'side', 'orderType', 'orderPrice',
            'placedTime', 'quantity', 'entryPrice', 'entryTime', 'stopLoss', 'takeProfit',
            'status', 'openedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.side in ['long', 'short']
          && isPrice(request.resource.data.quantity)
          && isPrice(request.resource.data.entryPrice)
          && request.resource.data.placedTime is int
          && request.resource.data.entryTime == request.resource.data.placedTime
          && optionalPrice(request.resource.data.stopLoss)
          && optionalPrice(request.resource.data.takeProfit)
          && ((request.resource.data.orderType == 'market'
              && request.resource.data.orderPrice == null
              && request.resource.data.status == 'open')
            || (request.resource.data.orderType in ['limit', 'stop']
              && request.resource.data.orderPrice == request.resource.data.entryPrice
              && request.resource.data.status == 'pending'))
          && request.resource.data.openedAt == request.time;

        allow update: if isOwner(resource.data.uid) && inTime(2) && (
          // A pending order moves its price, stop loss or take profit...
          (resource.data.status == 'pending'
            && changes(['orderPrice', 'entryPrice', 'stopLoss', 'takeProfit'])
            && isPrice(request.resource.data.orderPrice)
            && request.resource.data.entryPrice == request.resource.data.orderPrice
            && optionalPrice(request.resource.data.stopLoss)
            && optionalPrice(request.resource.data.takeProfit))
          // ...fills once...
          || (resource.data.status == 'pending'
            && changes(['status', 'entryPrice', 'entryTime', 'filledAt'])
            && request.resource.data.status == 'open'
            && isPrice(request.resource.data.entryPrice)
            && request.resource.data.entryTime is int
            && request.resource.data.entryTime > resource.data.placedTime
            && request.resource.data.filledAt == request.time)
          // ...or is cancelled.
          || (resource.data.status == 'pending'
            && changes(['status', 'closedAt'])
            && request.resource.data.status == 'cancelled'
            && request.resource.data.closedAt == request.time)
          // An open trade moves its stop loss or take profit; its entry never changes...
          || (resource.data.status == 'open'
            && changes(['stopLoss', 'takeProfit'])
            && optionalPrice(request.resource.data.stopLoss)
            && optionalPrice(request.resource.data.takeProfit))
          // ...and is closed exactly once.
          || (resource.data.status == 'open'
            && changes(['status', 'exitPrice', 'exitTime', 'exitReason', 'pnl', 'closedAt'])
            && request.resource.data.status == 'closed'
            && isPrice(request.resource.data.exitPrice)
            && request.resource.data.exitTime is int
            && request.resource.data.exitTime >= resource.data.entryTime
            && request.resource.data.exitReason in ['manual', 'stopLoss', 'takeProfit', 'stopOut', 'sessionEnd']
            && request.resource.data.pnl is number
            && request.resource.data.closedAt == request.time));

        allow delete: if isAdmin();
      }
    }

    // Everything else is closed by default.
  }
}
